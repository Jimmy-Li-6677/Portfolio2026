# Copy this file to .env and set your connection string.
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
# If you get "querySrv ECONNREFUSED", Node can't do the DNS lookup that mongodb+srv:// needs.
# Use the standard format instead, listing the cluster's hosts directly:
# MONGODB_URI=mongodb://<user>:<password>@<host-00>:27017,<host-01>:27017,<host-02>:27017/portfolio?ssl=true&replicaSet=<replica-set>&authSource=admin
